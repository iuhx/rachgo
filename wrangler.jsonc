// Cloudflare Workers — static assets only, no Worker script needed.
// Deploy from this folder:  npx wrangler deploy
{
  "name": "rachgo",
  "compatibility_date": "2026-09-01",
  "assets": {
    // publish.mjs builds this folder from the repo — .git and source
    // files (README, publish.mjs…) are never uploaded
    "directory": "./site",
    // "/" serves ./site/index.html
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
